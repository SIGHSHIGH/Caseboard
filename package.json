{
  "name": "caseboard",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "案情板 CaseBoard — 数字时代的刑侦白板",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "tsc -p tsconfig.smoke.json && node scripts/smoke.cjs",
    "ui-smoke": "node scripts/ui-smoke.cjs",
    "bench": "tsc -p tsconfig.smoke.json && node scripts/bench-dsl.cjs",
    "bench:board": "node scripts/bench-board.cjs",
    "verify": "tsc --noEmit && vite build && tsc -p tsconfig.smoke.json && node scripts/smoke.cjs && node scripts/ui-smoke.cjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/lr": "^1.4.11",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-sql": "^2.6.0",
    "@xyflow/react": "^12.3.6",
    "fflate": "~0.8.3",
    "immer": "^10.1.1",
    "pdf-lib": "~1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@lezer/generator": "^1.8.1",
    "@tauri-apps/cli": "^2.12.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
