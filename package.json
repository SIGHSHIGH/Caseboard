{
  "name": "caseboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "案情板 CaseBoard — 数字时代的刑侦白板",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "tsc -p tsconfig.smoke.json && node scripts/smoke.cjs",
    "ui-smoke": "node scripts/ui-smoke.cjs",
    "verify": "tsc --noEmit && vite build && tsc -p tsconfig.smoke.json && node scripts/smoke.cjs && node scripts/ui-smoke.cjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.3.6",
    "immer": "^10.1.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
